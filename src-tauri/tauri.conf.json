{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rigside",
  "version": "0.1.2",
  "identifier": "io.github.rigside",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rigside",
        "url": "index.html",
        "width": 1024,
        "height": 600,
        "minWidth": 320,
        "minHeight": 240,
        "backgroundColor": "#05080f",
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://air-quality-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rigside contributors",
    "shortDescription": "Themed second-screen dashboard for gaming PCs",
    "longDescription": "Rigside shows the time, weather, what's playing, PC stats and your macros on a second screen or small USB display, with animated game-inspired themes.",
    "copyright": "MIT licence",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMDA0QzBCRkNENjk4RTUKUldUbG1OYjhDMHdBa0RTSjcrY1pRaXJJUXk0ZllDMGl6a25aT05kWUZvK2tKQlF4U2tVT05iamIK",
      "endpoints": [
        "https://github.com/OWNER/rigside/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
